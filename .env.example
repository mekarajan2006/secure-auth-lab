# Server Configuration
PORT=3000
NODE_ENV=development

# Session Configuration
# Mandatory in production: use a strong random secret (e.g. openssl rand -hex 32)
SESSION_SECRET=replace_with_a_secure_random_64_character_string_here

# Security & Cookie Settings
# Set to 'true' in production or behind HTTPS
COOKIE_SECURE=false

# Session Timeouts (milliseconds)
# Idle timeout: 15 minutes (900000 ms)
SESSION_IDLE_TIMEOUT_MS=900000
# Absolute session expiry: 8 hours (28800000 ms)
SESSION_ABSOLUTE_TIMEOUT_MS=28800000

# Rate Limiting Settings
# Login limit: 5 attempts per 15 minutes per IP+email
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
# Register limit: 20 attempts per 15 minutes per IP
REGISTER_RATE_LIMIT_WINDOW_MS=900000
REGISTER_RATE_LIMIT_MAX=20

# Database & Logging
DB_PATH=auth.db
AUDIT_LOG_PATH=logs/audit.log
